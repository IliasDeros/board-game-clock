rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      allow get: if true;
      // The Join game box lists games created in the last couple of minutes.
      // Rules are not filters: the query itself must be bounded by createdAt.
      allow list: if request.query.limit <= 20
        && resource.data.createdAt > request.time - duration.value(3, 'm');
      allow write: if isValidGame(request.resource.data);
      allow delete: if false;
    }

    // Clients write serverTimestamp() here and read it back to measure how far
    // their clock is from the server's.
    match /clockProbes/{clientId} {
      allow get: if true;
      allow create, update: if clientId.size() <= 32
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t == request.time;
      allow list, delete: if false;
    }
  }
}

function isValidGame(data) {
  return data.players is list
    && data.players.size() >= 2
    && data.players.size() <= 12
    && data.status in ['running', 'paused']
    && data.activePlayerIndex is int
    && data.activePlayerIndex >= 0
    && data.activePlayerIndex < data.players.size()
    && data.initialMs is number
    && data.initialMs > 0
    && data.expiresAt is timestamp
    && ((data.status == 'paused' && data.turnStartedAt == null)
        || (data.status == 'running' && data.turnStartedAt is timestamp));
}
